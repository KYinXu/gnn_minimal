{
  "_documentation": "Same as gnn_final_train.json but node features are one-hot + per-residue ESM2 (no VAE table, no PDB continuous).",
  "seed": 42,
  "epochs": 300,
  "batch_size": 32,
  "lr": 0.001,
  "weight_decay": 0.0001,
  "patience": 30,
  "val_size": 0.2,
  "hidden_channels": 64,
  "esm2_hidden_dim": 64,
  "num_layers": 3,
  "dropout": 0.2,
  "distance_threshold": 8.0,
  "label_smoothing": 0.08,
  "logit_penalty": 0.0001,
  "node_feature_groups": {
    "onehot": true,
    "pdb_continuous": false,
    "vae_table": false,
    "esm2_residue": true
  },
  "architectures": ["gat"],
  "feature_sets_default": ["Graph-only"],
  "feature_sets": {
    "Graph-only": {"use_geo": false, "use_qsar": false},
    "Geo": {"use_geo": true, "use_qsar": false},
    "QSAR": {"use_geo": false, "use_qsar": true},
    "Combined": {"use_geo": true, "use_qsar": true}
  }
}
